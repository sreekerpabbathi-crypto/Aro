# ==============================================================================
# ARO — Environment Variables Blueprint
# ==============================================================================
# IMPORTANT: Never commit actual secret keys or SUPABASE_SERVICE_ROLE_KEY to git
# or expose them to client-side bundles.

# Supabase Public Configuration (Safe for client-side use)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# MapLibre Map Style URL (Using OpenFreeMap Bright — zero API key required)
VITE_MAPLIBRE_STYLE_URL=https://tiles.openfreemap.org/styles/bright
